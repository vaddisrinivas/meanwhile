{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.json",
  "title": "Meanwhile catalogue",
  "type": "object",
  "required": [
    "name",
    "version",
    "purpose",
    "agent_contract",
    "wait_modes",
    "packs",
    "history_signals",
    "resources",
    "quests"
  ],
  "properties": {
    "name": { "const": "Meanwhile" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "purpose": { "type": "string", "minLength": 1 },
    "agent_contract": {
      "type": "object",
      "required": ["trigger_when", "do_not_trigger_when", "selection_order", "rules", "outcome_record", "delivery", "output_template", "query_params"]
    },
    "wait_modes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/waitMode" }
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pack" }
    },
    "history_signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/historySignal" }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    },
    "quests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/quest" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "historySignal": {
      "type": "object",
      "required": ["id", "label", "bias"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "bias": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "waitMode": {
      "type": "object",
      "required": ["id", "label", "description", "minimum_wait_seconds", "maximum_quest_seconds", "requires_prior_opt_in"],
      "properties": {
        "id": { "enum": ["micro", "journey"] },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "minimum_wait_seconds": { "type": "integer", "minimum": 1 },
        "maximum_quest_seconds": { "type": "integer", "minimum": 1 },
        "requires_prior_opt_in": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "pack": {
      "type": "object",
      "required": ["id", "title", "description", "quest_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "quest_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["id", "label", "url"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      },
      "additionalProperties": false
    },
    "quest": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "mode",
        "states",
        "minutes",
        "duration_seconds",
        "intents",
        "signals",
        "contexts",
        "prompt",
        "receipt",
        "return_policy"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "learn-user",
            "proof",
            "reality",
            "decide",
            "test",
            "taste",
            "scope",
            "retrieve",
            "observe",
            "research",
            "learn",
            "play",
            "recover"
          ]
        },
        "mode": { "enum": ["micro", "journey"] },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["busy", "blocked", "proof", "taste", "frustrated", "learning"]
          }
        },
        "minutes": { "enum": [1, 3, 5, 10, 20] },
        "duration_seconds": { "enum": [60, 180, 300, 600, 1200] },
        "intents": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["useful", "learn-user", "learn", "play"] }
        },
        "signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "prompt": { "type": "string", "minLength": 1 },
        "receipt": { "type": "string", "minLength": 1 },
        "return_policy": {
          "enum": ["none", "optional", "reply_in_chat"]
        },
        "resource": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    }
  }
}
